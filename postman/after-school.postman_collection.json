{
  "info": {
    "name": "After-School Lessons API",
    "description": "Requests for the CST3144 Express.js back-end. Change the baseUrl variable to the render.com address once the server is deployed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "lessonId", "value": "6af460507bea4599f4fd86a0" }
  ],
  "item": [
    {
      "name": "GET all lessons",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/lessons"
      }
    },
    {
      "name": "POST new order",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sara Ahmed\",\n  \"phone\": \"0501234567\",\n  \"lessons\": [\n    { \"lessonId\": \"{{lessonId}}\", \"spaces\": 2 }\n  ]\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/orders"
      }
    },
    {
      "name": "PUT update lesson space",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"space\": 3\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/lessons/{{lessonId}}"
      }
    },
    {
      "name": "GET lesson image (exists)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/images/maths.png"
      }
    },
    {
      "name": "GET lesson image (missing - 404)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/images/does-not-exist.png"
      }
    }
  ]
}
